{
  "title": "NS Server Dashboard",
  "annotations": {
    "list": [
      {
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": false,
        "iconColor": "#ffffff",
        "limit": 500,
        "matchAny": true,
        "name": "Topology",
        "showIn": 0,
        "tags": [
          "topology"
        ],
        "type": "tags"
      },
      {
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": false,
        "iconColor": "#115fd4",
        "limit": 500,
        "matchAny": true,
        "name": "Buckets",
        "showIn": 0,
        "tags": [
          "buckets"
        ],
        "type": "tags"
      }
    ]
  },
  "_base": "dashboard",
  "_panels": [
    {
      "title": "CPU",
      "_base": "row"
    },
    {
      "title": "sys_cpu_utilization_rate",
      "description": "Uses the non-deprecated sys_cpu_cgroup_usage_seconds_total/sys_cpu_host_seconds_total counters when present, falling back to the deprecated sys_cpu_utilization_rate (7.6.0) on older clusters. Matches ns_server's own derivation of sys_cpu_utilization_rate. The fallback is wrapped in sum without(name) so that its label set matches the computed alternatives, which drop the name label; otherwise `or` would union both instead of preferring the non-deprecated one.",
      "_base": "panel",
      "_targets": [
        {
          "datasource": "{data-source:name}",
          "expr": "(irate(sys_cpu_cgroup_usage_seconds_total[1m]) / ignoring(name,mode) sys_cpu_cores_available * 100) or (100 - (irate(sys_cpu_host_seconds_total{mode=\"idle\"}[1m]) / ignoring(name,mode) sys_cpu_host_cores_available * 100)) or sum without(name) (sys_cpu_utilization_rate)",
          "legendFormat": "{data-source:name} sys_cpu_utilization_rate",
          "_base": "target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 1
          },
          "unit": "percent"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "type": "timeseries"
    },
    {
      "title": "total cpu & ns-server cpu utilization",
      "description": "Uses the non-deprecated sys_cpu_cgroup/host_seconds_total counters (in cores) and sysproc_cpu_seconds_total (mode=user+sys) when present, falling back to the deprecated sys_cpu_utilization_rate/sysproc_cpu_utilization (both 7.6.0) on older clusters. Both fallbacks are wrapped in sum without(name) so their label sets match the computed alternatives: without it `or` returns both series, and the resulting two-series vector cannot be multiplied by sys_cpu_cores_available (many-to-one matching error).",
      "_base": "panel",
      "_targets": [
        {
          "datasource": "{data-source:name}",
          "expr": "((irate(sys_cpu_cgroup_usage_seconds_total[1m]) / ignoring(name,mode) sys_cpu_cores_available * 100) or (100 - (irate(sys_cpu_host_seconds_total{mode=\"idle\"}[1m]) / ignoring(name,mode) sys_cpu_host_cores_available * 100)) or sum without(name) (sys_cpu_utilization_rate)) * ignoring(name) sys_cpu_cores_available",
          "legendFormat": "{data-source:name} sys_cpu_utilization_rate (in cores)",
          "_base": "target"
        },
        {
          "datasource": "{data-source:name}",
          "expr": "(irate(sysproc_cpu_seconds_total{proc=\"ns_server\",mode=\"user\"}[1m]) + ignoring(name,mode) irate(sysproc_cpu_seconds_total{proc=\"ns_server\",mode=\"sys\"}[1m])) * 100 or sum without(name) (sysproc_cpu_utilization{proc=\"ns_server\"})",
          "legendFormat": "{data-source:name} {{proc}}",
          "_base": "target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 1
          },
          "unit": "percent"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "type": "timeseries"
    },
    {
      "title": "cpu stolen rate",
      "description": "Uses the non-deprecated sys_cpu_host_seconds_total counter (mode=stolen) when present, falling back to the deprecated sys_cpu_stolen_rate (7.6.0) on older clusters. ns_server derives this from the host counter only, and only on Linux. The fallback is wrapped in sum without(name) so its label set matches the computed alternative; otherwise `or` would return both series.",
      "_base": "panel",
      "_targets": [
        {
          "datasource": "{data-source:name}",
          "expr": "(irate(sys_cpu_host_seconds_total{mode=\"stolen\"}[1m]) / ignoring(name,mode) sys_cpu_host_cores_available * 100) or sum without(name) (sys_cpu_stolen_rate)",
          "legendFormat": "{data-source:name} cpu stolen rate",
          "_base": "target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 1
          },
          "unit": "percent"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "type": "timeseries"
    },
    {
      "title": "cpu irq rate",
      "description": "Uses the non-deprecated sys_cpu_host_seconds_total counter (mode=irq) when present, falling back to the deprecated sys_cpu_irq_rate (7.6.0) on older clusters. ns_server derives this from the host counter only, and only on Linux. The fallback is wrapped in sum without(name) so its label set matches the computed alternative; otherwise `or` would return both series.",
      "_base": "panel",
      "_targets": [
        {
          "datasource": "{data-source:name}",
          "expr": "(irate(sys_cpu_host_seconds_total{mode=\"irq\"}[1m]) / ignoring(name,mode) sys_cpu_host_cores_available * 100) or sum without(name) (sys_cpu_irq_rate)",
          "legendFormat": "{data-source:name} cpu irq rate",
          "_base": "target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 1
          },
          "unit": "percent"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "type": "timeseries"
    },
    {
      "title": "sys_cpu_cores_available",
      "_base": "panel",
      "_targets": [
        {
          "datasource": "{data-source:name}",
          "expr": "sys_cpu_cores_available",
          "legendFormat": "{data-source:name} {{name}}",
          "_base": "target"
